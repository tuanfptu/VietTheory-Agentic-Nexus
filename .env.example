# Copy this file to .env and fill values locally. Never commit real credentials.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
VIETTHEORY_AGENTIC=0
VIETTHEORY_SEARCH_MODE=global
VIETTHEORY_RECOVERY_TOP_K=5
VIETTHEORY_RECOVERY_SUPPORT_MARGIN=0.0
LLM_BASE_URL=

# Local runtime. Qwen embedding and reranker run on CUDA; FAISS stays on CPU.
VIETTHEORY_DEVICE=cuda
VIETTHEORY_HYBRID_CANDIDATE_K=30
VIETTHEORY_RERANK_BATCH_SIZE=4
VIETTHEORY_RERANK_CANDIDATE_K=12
VIETTHEORY_TOP_K=5

# Qwen reranker logits calibrated for the MLN111 runtime.
# Global five-subject mode uses the related-evidence cutoff; the old -1.0
# threshold was calibrated only for the legacy MLN111-only runtime.
VIETTHEORY_GATE_SUFFICIENT=-5.0
VIETTHEORY_GATE_RELATED=-5.0
